@page "/login"
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager Navigation
@code {
    protected override void OnInitialized()
    {
        var uri = new Uri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        var returnUrl = "/";
        if (query.TryGetValue("returnUrl", out var returnUrlValues))
        {
            var returnUrlString = returnUrlValues.FirstOrDefault();
            if (!string.IsNullOrEmpty(returnUrlString))
            {
                returnUrl = returnUrlString;
            }
        }

        Navigation.NavigateTo($"/authentication/login?returnUrl={Uri.EscapeDataString(returnUrl)}", forceLoad: true);
    }
}
