@page "/postreader/{PostId}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using NoteBookmark.Domain
@using Microsoft.FluentUI.AspNetCore.Components
@inject IDataService DataService
@inject NavigationManager Navigation

<PageTitle>@(post?.Title ?? "Reading...")</PageTitle>

<FluentStack Orientation="Orientation.Vertical" Style="width: 100%; max-width: 800px; margin: 0 auto; padding: 1rem; box-sizing: border-box;">
    <FluentStack Orientation="Orientation.Vertical" Style="width: 100%; gap: 0.5rem; margin-bottom: 1rem;">
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center">
            <FluentButton OnClick="@(() => Navigation.NavigateTo("/posts"))"
                          IconStart="@(new Icons.Regular.Size20.ArrowLeft())"
                          Title="Back to posts">Back</FluentButton>
            <FluentSpacer />
            <span style="font-weight: 600;">Text size:</span>
            <span>@(textSize)px</span>
        </FluentStack>
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Style="width: 100%; gap: 0.5rem;">
            <FluentButton IconStart="@(new Icons.Regular.Size20.Subtract())"
                          OnClick="DecreaseTextSize"
                          Disabled="@(textSize <= MinTextSize)"
                          Title="Decrease text size"
                          aria-label="Decrease text size" />
            <FluentSlider Min="@MinTextSize" Max="@MaxTextSize" Step="1" @bind-Value="textSize" Style="flex-grow: 1; touch-action: none;" aria-label="Text size slider" />
            <FluentButton IconStart="@(new Icons.Regular.Size20.Add())"
                          OnClick="IncreaseTextSize"
                          Disabled="@(textSize >= MaxTextSize)"
                          Title="Increase text size"
                          aria-label="Increase text size" />
        </FluentStack>
    </FluentStack>

    @if (isLoading)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        @if (post != null)
        {
            <h1 style="margin-bottom: 0.25rem; word-break: break-word;">@post.Title</h1>
            <FluentStack Orientation="Orientation.Horizontal" Style="color: var(--neutral-fill-stealth-rest); gap: 0.5rem; margin-bottom: 1rem;">
                @if (!string.IsNullOrEmpty(post.Author))
                {
                    <span>@post.Author</span>
                }
                @if (!string.IsNullOrEmpty(post.Date_published) && post.Date_published.Length >= 10)
                {
                    <span>· @post.Date_published[..10]</span>
                }
            </FluentStack>
        }

        @if (htmlContent != null)
        {
            <div class="reader-content" style="font-size: @(textSize)px; line-height: 1.7;">
                @((MarkupString)htmlContent)
            </div>
        }
        else
        {
            <p><em>Content not available.</em></p>
        }

        <FluentDivider Style="margin: 2rem 0 1rem 0;" />

        <FluentStack Orientation="Orientation.Vertical" Style="width: 100%; gap: 0.5rem; margin-top: 1rem;">
            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center">
                <FluentButton OnClick="@(() => Navigation.NavigateTo("/posts"))"
                              IconStart="@(new Icons.Regular.Size20.ArrowLeft())"
                              Title="Back to posts">Back</FluentButton>
                <FluentSpacer />
                <span style="font-weight: 600;">Text size:</span>
                <span>@(textSize)px</span>
            </FluentStack>
            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Style="width: 100%; gap: 0.5rem;">
                <FluentButton IconStart="@(new Icons.Regular.Size20.Subtract())"
                              OnClick="DecreaseTextSize"
                              Disabled="@(textSize <= MinTextSize)"
                              Title="Decrease text size"
                              aria-label="Decrease text size" />
                <FluentSlider Min="@MinTextSize" Max="@MaxTextSize" Step="1" @bind-Value="textSize" Style="flex-grow: 1; touch-action: none;" aria-label="Text size slider" />
                <FluentButton IconStart="@(new Icons.Regular.Size20.Add())"
                              OnClick="IncreaseTextSize"
                              Disabled="@(textSize >= MaxTextSize)"
                              Title="Increase text size"
                              aria-label="Increase text size" />
            </FluentStack>
        </FluentStack>
    }
</FluentStack>

@code {
    public const int MinTextSize = 12;
    public const int MaxTextSize = 25;

    [Parameter]
    public string PostId { get; set; } = string.Empty;

    private Post? post;
    private string? htmlContent;
    private bool isLoading = true;
    private int _textSize = 16;
    private int textSize
    {
        get => _textSize;
        set
        {
            var clamped = Math.Clamp(value, MinTextSize, MaxTextSize);
            if (_textSize != clamped)
            {
                _textSize = clamped;
            }
        }
    }

    private void DecreaseTextSize()
    {
        if (textSize > MinTextSize)
        {
            textSize--;
        }
    }

    private void IncreaseTextSize()
    {
        if (textSize < MaxTextSize)
        {
            textSize++;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var postTask = DataService.GetPost(PostId);
        var htmlTask = DataService.GetPostHtmlAsync(PostId);

        await Task.WhenAll(postTask, htmlTask);

        post = await postTask;
        htmlContent = await htmlTask;
        isLoading = false;
    }
}
