@page "/quickadd"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using NoteBookmark.Domain
@inject IDataService client
@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime
@layout MinimalLayout

<PageTitle>Quick Add - NoteBookmark</PageTitle>

<div style="padding: 1rem; max-width: 460px; margin: 0 auto; font-family: var(--body-font);">
    <FluentStack Orientation="Orientation.Vertical" Style="gap: 1rem;">
        <FluentLabel Typo="Typography.H4">Quick Add Post</FluentLabel>

        @if (isLoading)
        {
            <FluentStack Orientation="Orientation.Vertical" VerticalAlignment="VerticalAlignment.Center" HorizontalAlignment="HorizontalAlignment.Center" Style="padding: 2rem 0; gap: 1rem;">
                <FluentProgressRing Style="width: 48px; height: 48px;" />
                <FluentLabel Typo="Typography.Body">Extracting and saving post details...</FluentLabel>
            </FluentStack>
        }
        else if (isSuccess && post != null)
        {
            <FluentMessageBar Intent="MessageIntent.Success">
                Post saved successfully!
            </FluentMessageBar>

            <FluentCard Style="padding: 1rem; margin-top: 0.5rem;">
                <FluentStack Orientation="Orientation.Vertical" Style="gap: 0.75rem;">
                    <div>
                        <FluentLabel Typo="Typography.Body" Style="font-weight: 600; color: var(--neutral-foreground-rest);">Title</FluentLabel>
                        <FluentLabel Typo="Typography.Subject" Style="font-size: 1.1rem; margin-top: 0.25rem;">@(string.IsNullOrWhiteSpace(post.Title) ? "Untitled" : post.Title)</FluentLabel>
                    </div>

                    <div>
                        <FluentLabel Typo="Typography.Body" Style="font-weight: 600; color: var(--neutral-foreground-rest);">Author</FluentLabel>
                        <FluentLabel Typo="Typography.Body" Style="margin-top: 0.25rem;">@(string.IsNullOrWhiteSpace(post.Author) ? "Unknown" : post.Author)</FluentLabel>
                    </div>

                    <div>
                        <FluentLabel Typo="Typography.Body" Style="font-weight: 600; color: var(--neutral-foreground-rest);">URL</FluentLabel>
                        <div style="margin-top: 0.25rem; word-break: break-all;">
                            <a href="@post.Url" target="_blank" rel="noopener noreferrer" style="color: var(--accent-fill-rest); font-size: 0.9rem;">@post.Url</a>
                        </div>
                    </div>
                </FluentStack>
            </FluentCard>

            <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.End" Style="gap: 0.75rem; margin-top: 1rem;">
                <FluentButton Appearance="Appearance.Neutral" OnClick="CloseWindow">Close Window</FluentButton>
                <FluentButton Appearance="Appearance.Accent" OnClick="NavigateToEdit" IconEnd="@(new Icons.Regular.Size16.Edit())">Edit</FluentButton>
            </FluentStack>
        }
        else
        {
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <FluentMessageBar Intent="MessageIntent.Error">
                    @errorMessage
                </FluentMessageBar>
            }

            <FluentStack Orientation="Orientation.Vertical" Style="gap: 0.75rem; margin-top: 0.5rem;">
                <FluentTextField @bind-Value="manualUrl" Placeholder="Enter or paste URL" Style="width: 100%;" />
                <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.End" Style="gap: 0.75rem;">
                    <FluentButton Appearance="Appearance.Neutral" OnClick="CloseWindow">Close Window</FluentButton>
                    <FluentButton Appearance="Appearance.Accent" OnClick="ProcessManualUrl" Disabled="@(string.IsNullOrWhiteSpace(manualUrl))">Add</FluentButton>
                </FluentStack>
            </FluentStack>
        }
    </FluentStack>
</div>

@code {
    [SupplyParameterFromQuery(Name = "url")]
    public string? Url { get; set; }

    [SupplyParameterFromQuery(Name = "addUrl")]
    public string? AddUrl { get; set; }

    private Post? post;
    private bool isLoading = false;
    private bool isSuccess = false;
    private string? errorMessage;
    private string? manualUrl;
    private string? _processedUrl;

    protected override async Task OnParametersSetAsync()
    {
        var targetUrl = !string.IsNullOrWhiteSpace(Url) ? Url : AddUrl;
        if (!string.IsNullOrWhiteSpace(targetUrl) && targetUrl != _processedUrl)
        {
            _processedUrl = targetUrl;
            await ProcessUrlAsync(targetUrl);
        }
    }

    private async Task ProcessUrlAsync(string targetUrl)
    {
        if (client.IsOffline)
        {
            errorMessage = "Cannot extract posts while offline.";
            isLoading = false;
            return;
        }

        isLoading = true;
        errorMessage = null;
        isSuccess = false;

        try
        {
            post = await client.ExtractPostDetailsAndSave(targetUrl);
            if (post != null)
            {
                isSuccess = true;
            }
            else
            {
                errorMessage = "Failed to extract and save post details. Please check the URL and try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ProcessManualUrl()
    {
        if (!string.IsNullOrWhiteSpace(manualUrl))
        {
            await ProcessUrlAsync(manualUrl);
        }
    }

    private async Task CloseWindow()
    {
        try
        {
            await JsRuntime.InvokeVoidAsync("window.close");
        }
        catch
        {
            // Prerender or context without window.close support
        }
    }

    private void NavigateToEdit()
    {
        var rowKey = post?.RowKey ?? post?.Id;
        if (!string.IsNullOrEmpty(rowKey))
        {
            Navigation.NavigateTo($"posteditorlight/{rowKey}");
        }
    }
}
