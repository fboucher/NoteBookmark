@page "/settings"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.FluentUI.AspNetCore.Components.Extensions
@using NoteBookmark.Domain
@inject IDataService client
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Settings</PageTitle>

<FluentDesignTheme @bind-Mode="@Mode"
                   @bind-OfficeColor="@OfficeColor"
                   StorageName="theme" />

<div class="settings-page">
    <h3>Settings</h3>

    @if (settings is null)
    {
        <FluentProgressRing />
    }
    else
    {
        <EditForm Model="@settings" OnValidSubmit="SaveSettings" OnInvalidSubmit="ShowInvalidFields">
            <DataAnnotationsValidator />

            <FluentAccordion ExpandMode="AccordionExpandMode.Multi">

                <FluentAccordionItem Expanded="@IsOpen(Section.Appearance)"
                                     ExpandedChanged="@(open => SetOpen(Section.Appearance, open))">
                    <HeadingTemplate>
                        <SettingsSectionHeading Icon="@(new Icons.Regular.Size20.PaintBrush())"
                                                Title="Appearance"
                                                Summary="@SettingsSummary.Appearance(Mode.ToString(), OfficeColor?.ToString(), settings.FontSize)" />
                    </HeadingTemplate>
                    <ChildContent>
                        <div class="settings-fields">
                            <div class="settings-row">
                                <div class="settings-field">
                                    <FluentSelect Label="Theme" Width="100%"
                                                  Items="@(Enum.GetValues<DesignThemeModes>())"
                                                  @bind-SelectedOption="@Mode" />
                                </div>
                                <div class="settings-field">
                                    <FluentSelect Label="Accent color" Width="100%" Height="200px"
                                                  Items="@(Enum.GetValues<OfficeColor>().Select(i => (OfficeColor?)i))"
                                                  @bind-SelectedOption="@OfficeColor">
                                        <OptionTemplate Context="color">
                                            <FluentStack>
                                                <FluentIcon Value="@(new Icons.Filled.Size20.RectangleLandscape())" Color="Color.Custom"
                                                            CustomColor="@(color.ToAttributeValue() != "default" ? color.ToAttributeValue() : "#036ac4")" />
                                                <FluentLabel>@color</FluentLabel>
                                            </FluentStack>
                                        </OptionTemplate>
                                    </FluentSelect>
                                </div>
                                <div class="settings-field">
                                    <FluentSelect Label="Font size" Width="100%"
                                                  Items="@fontSizeOptions"
                                                  OptionText="@(i => i.Text)"
                                                  OptionValue="@(i => i.Value)"
                                                  @bind-Value="settings.FontSize" />
                                </div>
                            </div>
                            <p class="settings-hint">Theme and color apply right away on this device. Font size is saved with the other settings.</p>
                        </div>
                    </ChildContent>
                </FluentAccordionItem>

                <FluentAccordionItem Expanded="@IsOpen(Section.ReadingNotes)"
                                     ExpandedChanged="@(open => SetOpen(Section.ReadingNotes, open))">
                    <HeadingTemplate>
                        <SettingsSectionHeading Icon="@(new Icons.Regular.Size20.Notebook())"
                                                Title="Reading notes"
                                                Summary="@SettingsSummary.ReadingNotes(settings)" />
                    </HeadingTemplate>
                    <ChildContent>
                        <div class="settings-fields">
                            <div class="settings-row">
                                <div class="settings-field">
                                    <FluentTextField Label="Last bookmark date" @bind-Value="settings.LastBookmarkDate" Style="width:100%" />
                                </div>
                                <div class="settings-inline">
                                    <div class="settings-field">
                                        <FluentTextField Label="Reading notes counter" @bind-Value="settings.ReadingNotesCounter" Style="width:100%" />
                                    </div>
                                    <FluentButton Id="increment-counter" Appearance="Appearance.Outline"
                                                  Title="Increment counter" aria-label="Increment counter"
                                                  IconStart="@(new Icons.Regular.Size16.Add())" OnClick="IncrementCounter" />
                                </div>
                            </div>
                            <p class="settings-hint">The counter is the number given to your next reading notes.</p>
                        </div>
                    </ChildContent>
                </FluentAccordionItem>

                <FluentAccordionItem Expanded="@IsOpen(Section.ContentFilters)"
                                     ExpandedChanged="@(open => SetOpen(Section.ContentFilters, open))">
                    <HeadingTemplate>
                        <SettingsSectionHeading Icon="@(new Icons.Regular.Size20.Filter())"
                                                Title="Content filters"
                                                Summary="@SettingsSummary.ContentFilters(settings)" />
                    </HeadingTemplate>
                    <ChildContent>
                        <div class="settings-fields">
                            <div class="settings-field">
                                <FluentTextField Label="Favorite domains" @bind-Value="settings.FavoriteDomains" Style="width:100%" />
                            </div>
                            <p class="settings-hint">Comma separated. When set, AI search only looks at these domains.</p>
                            <div class="settings-field">
                                <FluentTextField Label="Blocked domains" @bind-Value="settings.BlockedDomains" Style="width:100%" />
                            </div>
                            <p class="settings-hint">Comma separated. AI search skips these domains when no favorite domains are set.</p>
                        </div>
                    </ChildContent>
                </FluentAccordionItem>

                <FluentAccordionItem Expanded="@IsOpen(Section.Ai)"
                                     ExpandedChanged="@(open => SetOpen(Section.Ai, open))">
                    <HeadingTemplate>
                        <SettingsSectionHeading Icon="@(new Icons.Regular.Size20.Sparkle())"
                                                Title="AI"
                                                Summary="@SettingsSummary.Ai(settings)" />
                    </HeadingTemplate>
                    <ChildContent>
                        <div class="settings-fields">
                            <h5 class="settings-subhead">Provider</h5>
                            <p class="settings-hint">
                                Any OpenAI-compatible provider works. The Base URL must end at <code>/v1</code> (without <code>/chat/completions</code>).
                                See the <a href="https://github.com/fboucher/NoteBookmark/blob/main/docs/ai-provider-setup.md" target="_blank" rel="noopener">AI provider setup guide</a> for OpenCode, OpenRouter and Ollama examples.
                            </p>
                            <div class="settings-field">
                                <FluentTextField Label="API key" @bind-Value="settings.AiApiKey" TextFieldType="TextFieldType.Password" Style="width:100%" />
                            </div>
                            <div class="settings-row settings-row-wide">
                                <div class="settings-field">
                                    <FluentTextField Label="Base URL" @bind-Value="settings.AiBaseUrl" Placeholder="https://openrouter.ai/api/v1" Style="width:100%" />
                                </div>
                                <div class="settings-field">
                                    <FluentTextField Label="Model name" @bind-Value="settings.AiModelName" Placeholder="mistralai/mistral-small-3.2-24b-instruct" Style="width:100%" />
                                </div>
                            </div>
                            <h5 class="settings-subhead">Prompts</h5>
                            <div class="settings-field">
                                <FluentTextArea Label="Summary prompt" @bind-Value="settings.SummaryPrompt" Rows="3" Resize="TextAreaResize.Vertical" Style="width:100%" />
                                <FluentValidationMessage For="@(() => settings.SummaryPrompt)" />
                            </div>
                            <p class="settings-hint">Must contain <code>{content}</code>, replaced by the article text.</p>
                            <div class="settings-field">
                                <FluentTextArea Label="Search prompt" @bind-Value="settings.SearchPrompt" Rows="3" Resize="TextAreaResize.Vertical" Style="width:100%" />
                                <FluentValidationMessage For="@(() => settings.SearchPrompt)" />
                            </div>
                            <p class="settings-hint">Must contain <code>{topic}</code>, replaced at search time.</p>
                        </div>
                    </ChildContent>
                </FluentAccordionItem>

                <FluentAccordionItem Expanded="@IsOpen(Section.Feeds)"
                                     ExpandedChanged="@(open => SetOpen(Section.Feeds, open))">
                    <HeadingTemplate>
                        <SettingsSectionHeading Icon="@(new Icons.Regular.Size20.Rss())"
                                                Title="Feeds"
                                                Summary="@SettingsSummary.Feeds(settings)" />
                    </HeadingTemplate>
                    <ChildContent>
                        <div class="settings-fields">
                            <div class="settings-field">
                                <FluentSwitch Id="feed-refresh-enabled"
                                              Label="Background feed refresh"
                                              @bind-Value="settings.FeedRefreshEnabled" />
                            </div>
                            <div class="settings-row">
                                <div class="settings-field">
                                    <FluentSelect Id="feed-refresh-interval"
                                                  Label="Refresh interval"
                                                  Width="100%"
                                                  Disabled="@(!settings.FeedRefreshEnabled)"
                                                  Items="@feedRefreshIntervalOptions"
                                                  OptionText="@(i => i.Text)"
                                                  OptionValue="@(i => i.Value)"
                                                  @bind-Value="FeedRefreshIntervalValue" />
                                </div>
                            </div>
                            <p class="settings-hint">When on, feeds are checked for new posts in the background at this interval.</p>
                        </div>
                    </ChildContent>
                </FluentAccordionItem>

                <FluentAccordionItem Expanded="@IsOpen(Section.Bookmarklet)"
                                     ExpandedChanged="@(open => SetOpen(Section.Bookmarklet, open))">
                    <HeadingTemplate>
                        <SettingsSectionHeading Icon="@(new Icons.Regular.Size20.Bookmark())"
                                                Title="Bookmarklet"
                                                Summary="Save any page from your browser's bookmarks bar" />
                    </HeadingTemplate>
                    <ChildContent>
                        <div class="settings-fields">
                            <p>Drag the button to your browser's bookmarks bar to save the page you're reading straight into NoteBookmark.</p>
                            <div>
                                <a href="@BookmarkletCode" class="settings-bookmarklet" title="Drag to bookmarks bar" onclick="return false;">
                                    <FluentIcon Value="@(new Icons.Regular.Size16.Bookmark())" Color="Color.Fill" />
                                    + Add to NoteBookmark
                                </a>
                            </div>
                            <p class="settings-hint">Tip: If dragging is not supported, right-click the button, copy the link, and paste it as the URL of a new browser bookmark.</p>
                            <div class="settings-field">
                                <FluentTextArea ReadOnly="true" Value="@BookmarkletCode" Label="Bookmarklet code" Rows="3" Style="width:100%" />
                            </div>
                        </div>
                    </ChildContent>
                </FluentAccordionItem>

            </FluentAccordion>

            <div class="settings-savebar">
                @* Inside the sticky bar so a failed save is visible wherever the page is scrolled. *@
                <ValidationSummary />
                <span>Collapsed sections keep their changes. Save applies them all.</span>
                <FluentButton Id="cancel-settings" Appearance="Appearance.Outline" OnClick="Cancel">Cancel</FluentButton>
                <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent"
                              IconStart="@(new Icons.Regular.Size16.Save())">Save</FluentButton>
            </div>
        </EditForm>
    }
</div>


@code {
    public DesignThemeModes Mode { get; set; }
    public OfficeColor? OfficeColor { get; set; }

    private Domain.Settings? settings;

    private enum Section
    {
        Appearance,
        ReadingNotes,
        ContentFilters,
        Ai,
        Feeds,
        Bookmarklet
    }

    // Reading notes is the most edited section, so it is the only one open at first.
    private readonly HashSet<Section> openSections = [Section.ReadingNotes];

    private record FontSizeOption(string Text, string Value);
    private record FeedRefreshIntervalOption(string Text, string Value);

    private static readonly List<FontSizeOption> fontSizeOptions = new()
    {
        new("Small", "small"),
        new("Medium", "medium"),
        new("Large", "large")
    };

    private static readonly List<FeedRefreshIntervalOption> feedRefreshIntervalOptions =
        Domain.Settings.AllowedFeedRefreshIntervals
            .Select(minutes => new FeedRefreshIntervalOption(SettingsSummary.FormatInterval(minutes), minutes.ToString()))
            .ToList();

    private string FeedRefreshIntervalValue
    {
        get => (settings?.FeedRefreshIntervalMinutes is > 0
            ? settings.FeedRefreshIntervalMinutes
            : Domain.Settings.DefaultFeedRefreshIntervalMinutes).ToString();
        set
        {
            if (settings != null && int.TryParse(value, out var minutes))
            {
                settings.FeedRefreshIntervalMinutes = minutes;
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        settings = await client.GetSettings();
        if (settings != null)
        {
            if (string.IsNullOrWhiteSpace(settings.FontSize))
            {
                settings.FontSize = FontSizeHelper.DefaultFontSize;
            }
            if (settings.FeedRefreshIntervalMinutes <= 0)
            {
                settings.FeedRefreshIntervalMinutes = Domain.Settings.DefaultFeedRefreshIntervalMinutes;
            }
        }
    }

    private bool IsOpen(Section section) => openSections.Contains(section);

    private void SetOpen(Section section, bool open)
    {
        if (open)
        {
            openSections.Add(section);
        }
        else
        {
            openSections.Remove(section);
        }
    }

    // Only the prompts, in the AI section, are validated. Open it so the error is not hidden.
    private void ShowInvalidFields() => openSections.Add(Section.Ai);

    private async Task SaveSettings()
    {
        if (settings != null)
        {
            await client.SaveSettings(settings);
            try
            {
                var cssSize = FontSizeHelper.ToCssValue(settings.FontSize);
                await JSRuntime.InvokeVoidAsync("document.documentElement.style.setProperty", "--app-font-size", cssSize);
                await JSRuntime.InvokeVoidAsync("document.body.style.setProperty", "--app-font-size", cssSize);
            }
            catch
            {
                // Prerender / non-JS environment safe
            }
            Navigation.NavigateTo("/");
        }
    }

    private void Cancel() => Navigation.NavigateTo("/");

    private void IncrementCounter()
    {
        var cnt = Convert.ToInt32(settings!.ReadingNotesCounter) + 1;
        settings.ReadingNotesCounter = (cnt).ToString();
    }

    private string BookmarkletCode =>
        $"javascript:(function(){{var u=encodeURIComponent(window.location.href);window.open('{Navigation.BaseUri}quickadd?url='+u,'nb_quickadd','width=480,height=440,menubar=no,toolbar=no');}})();";
}
