@inherits LayoutComponentBase
@using Microsoft.Maui.Networking
@using Microsoft.Maui.ApplicationModel
@using Microsoft.FluentUI.AspNetCore.Components
@using NoteBookmark.MauiApp.Data
@inject IConnectivity Connectivity
@inject NavigationManager Navigation
@inject ISyncService SyncService
@inject IToastService ToastService
@implements IDisposable


<FluentLayout>
    <FluentHeader>
        Note Bookmark
        <FluentSpacer />
    </FluentHeader>

    <FluentStack Class="main" Orientation="Orientation.Horizontal" Width="100%">
        <NavMenu />
        <FluentBodyContent Class="body-content">
            @if (isOffline)
            {
                <FluentMessageBar Intent="MessageIntent.Warning" Title="Offline Mode" AllowDismiss="false">
                    You are currently offline. Changes will be saved locally.
                </FluentMessageBar>
            }
            <div class="content px-4">
                @Body
            </div>
        </FluentBodyContent>
    </FluentStack>

    <FluentFooter>
        <a href="https://github.com/fboucher/NoteBookmark" target="_blank" aria-label="GitHub" style="display: inline-flex; align-items: center; color: var(--neutral-foreground-rest); text-decoration: none;">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-github" viewBox="0 0 16 16">
                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
            </svg>
        </a>
        <FluentSpacer />
        <a href="https://fboucheros.com" target="_blank">About Frank B</a>
        <FluentSpacer />
        v. @appVersion
    </FluentFooter>
</FluentLayout>

<FluentToastProvider />
<FluentDialogProvider />

@code {
    private bool isOffline;
    private string appVersion = "1.0.0";

    protected override void OnInitialized()
    {
        isOffline = Connectivity.NetworkAccess != NetworkAccess.Internet;
        Connectivity.ConnectivityChanged += OnConnectivityChanged;
        Navigation.LocationChanged += OnLocationChanged;
        EnsureApiBaseUrlConfigured(Navigation.Uri);
        SyncService.ConflictDetected += OnSyncConflictDetected;

        try
        {
            appVersion = AppInfo.Current.VersionString;
        }
        catch
        {
            // Fallback for environment constraints or test suites
        }
    }

    private void OnSyncConflictDetected(object? sender, SyncConflictEventArgs e)
    {
        InvokeAsync(() =>
        {
            ToastService.ShowWarning(e.Message);
        });
    }

    private void OnConnectivityChanged(object? sender, ConnectivityChangedEventArgs e)
    {
        var wasOffline = isOffline;
        isOffline = e.NetworkAccess != NetworkAccess.Internet;
        if (wasOffline != isOffline)
        {
            InvokeAsync(StateHasChanged);
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        EnsureApiBaseUrlConfigured(e.Location);
    }

    private void EnsureApiBaseUrlConfigured(string location)
    {
        if (ApiBaseUrlSettings.HasConfiguredValue() || IsSetupRoute(location))
        {
            return;
        }

        Navigation.NavigateTo("/setup", replace: true);
    }

    private static bool IsSetupRoute(string location)
    {
        if (!Uri.TryCreate(location, UriKind.Absolute, out var uri))
        {
            return false;
        }

        var path = uri.AbsolutePath.TrimEnd('/');
        return string.Equals(path, "/setup", StringComparison.OrdinalIgnoreCase);
    }

    public void Dispose()
    {
        Connectivity.ConnectivityChanged -= OnConnectivityChanged;
        Navigation.LocationChanged -= OnLocationChanged;
        SyncService.ConflictDetected -= OnSyncConflictDetected;
    }
}
