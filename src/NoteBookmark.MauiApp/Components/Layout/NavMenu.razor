@using Microsoft.FluentUI.AspNetCore.Components

<div class="navmenu-container">
    <!-- Hamburger button visible only on mobile screens -->
    <div class="mobile-header">
        <FluentButton Id="hamburger-button" 
                      Icon="@(isMenuOpen ? new Icons.Regular.Size20.Dismiss() : new Icons.Regular.Size20.Navigation())" 
                      Appearance="Appearance.Stealth" 
                      OnClick="ToggleMenu" 
                      aria-label="Toggle menu" />
    </div>

    <!-- Navigation Menu wrapper -->
    <div class="nav-menu-wrapper @(isMenuOpen ? "open" : "collapsed")">
        <FluentNavMenu Id="main-menu" Collapsible="true" Width="250" Title="Navigation menu">
            <FluentNavLink Href="/" Match="NavLinkMatch.All" Icon="@(new Icons.Regular.Size20.Home())" IconColor="Color.Accent" OnClick="CloseMenu">Home</FluentNavLink>
            <FluentNavLink Href="posts" Icon="@(new Icons.Regular.Size20.Glasses())" IconColor="Color.Accent" OnClick="CloseMenu">Posts</FluentNavLink>
            <FluentNavLink Href="summaries" Icon="@(new Icons.Regular.Size20.BookNumber())" IconColor="Color.Accent" OnClick="CloseMenu">Summaries</FluentNavLink>
            <FluentNavLink Href="summaryeditor" Icon="@(new Icons.Regular.Size20.ArrowAutofitHeightIn())" IconColor="Color.Accent" OnClick="CloseMenu">Generate Summary</FluentNavLink>
            <FluentNavLink Href="search" Icon="@(new Icons.Regular.Size20.SearchSparkle())" IconColor="Color.Accent" OnClick="CloseMenu">Search</FluentNavLink>
            <FluentNavLink Href="appsettings" Icon="@(new Icons.Regular.Size20.Settings())" IconColor="Color.Accent" OnClick="CloseMenu">App Settings</FluentNavLink>
            <FluentNavLink Href="settings" Icon="@(new Icons.Regular.Size20.Server())" IconColor="Color.Accent" OnClick="CloseMenu">Server Settings</FluentNavLink>
        </FluentNavMenu>
    </div>
</div>

@code {
    private bool isMenuOpen = false;

    private void ToggleMenu()
    {
        isMenuOpen = !isMenuOpen;
    }

    private void CloseMenu()
    {
        isMenuOpen = false;
    }
}
